# TriChurn Phase 8 - example configuration. Copy to .env or export in your shell. NO secrets belong in this file.
# Every variable is optional; the defaults below are what the code uses when a variable is unset.

# Where MLflow stores runs/registry. Default: a local SQLite store under ./mlflow_local/ (created on first 'register').
# A remote server example: MLFLOW_TRACKING_URI=http://localhost:5000   (start one with: mlflow server --port 5000)
# MLFLOW_TRACKING_URI=

# Where run artifacts are stored when the experiment is first created. Default: ./mlflow_local/artifacts
# MLFLOW_ARTIFACT_LOCATION=

MLFLOW_EXPERIMENT_NAME=TriChurn-Churn-Prediction
MLFLOW_MODEL_NAME=TriChurn-Churn-Model
MLFLOW_MODEL_VERSION=2.0.0

# The locked Phase 2 artifact and its SHA-256 pin (relative paths are anchored at the project root).
TRICHURN_MODEL_PATH=models/trichurn_churn_model_v2.0.0.joblib
TRICHURN_MODEL_SHA256=db399a55f650c6681e1caaf52257f909777e2c5fada3af5911370ddf5b8ff1ad
