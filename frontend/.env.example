# Data source: "mock" (default, no backend needed) or "fastapi" (Phase 6 FastAPI backend)
VITE_DATA_PROVIDER=mock
# Only used when VITE_DATA_PROVIDER=fastapi
VITE_API_BASE_URL=http://localhost:8000
# Mock-mode only: artificial latency in ms (0 disables) and failure simulation ("always")
VITE_MOCK_LATENCY_MS=250
VITE_MOCK_FAIL=none
